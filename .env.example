# Database configuration
POSTGRES_DB=visionx_notifications
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5435
NOTIFICATIONS_PORT=8010

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Production

# Auth Service JWT validation
JWT_ISSUER=https://visionx.samstack.site/auth
JWT_AUDIENCE=visionx-app
JWT_JWKS_URL=https://visionx.samstack.site/auth/.well-known/jwks.json
JWT_SECRETS_DIR=/opt/VisionX/secrets
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# Firebase Push Notification configuration
FIREBASE_PROJECT_ID=visionx-notifications
FIREBASE_CREDENTIALS_PATH=/etc/firebase/service-account.json
# Or provide service account JSON directly:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Shared HMAC secret for session and internal events
SESSION_WEBHOOK_SECRET=VisionX_SessionEvent_SharedSecret_2026

# Internal or public VisionX Backend service URL
VISIONX_BACKEND_URL=https://visionx.samstack.site
